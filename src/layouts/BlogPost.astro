---
import BaseLayout from './BaseLayout.astro';
import { formatPostDate, isoDate } from '../lib/date';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
}

const { title, description, date, tags = [] } = Astro.props;
---

<BaseLayout title={`${title} | Sunbeam Consulting`} description={description}>
  <article class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-10">
        <a href="/blog" class="text-sm text-sunbeam-600 hover:text-sunbeam-700 font-medium">&larr; Back to Blog</a>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mt-4 mb-4">{title}</h1>
        <div class="flex items-center gap-4 text-sm text-slate-500">
          <time datetime={isoDate(date)}>{formatPostDate(date)}</time>
          {tags.length > 0 && (
            <div class="flex gap-2">
              {tags.map((tag) => (
                <span class="bg-sunbeam-50 text-sunbeam-700 px-2 py-0.5 rounded text-xs font-medium">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="mt-16 pt-8 border-t border-slate-200">
        <a href="/blog" class="text-sunbeam-600 hover:text-sunbeam-700 font-medium text-sm">&larr; Back to Blog</a>
      </footer>
    </div>
  </article>
</BaseLayout>
