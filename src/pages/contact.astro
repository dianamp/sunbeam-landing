---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Contact | Sunbeam Consulting" description="Book a free intro call or send a message. Let's talk about your AI strategy.">
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">Let's Talk</h1>
      <p class="text-lg text-slate-600 mb-12 max-w-2xl">
        Book a free intro call, or send a note. Whichever's easier.
      </p>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Reclaim.ai scheduling link -->
        <div>
          <h2 class="text-xl font-bold text-slate-900 mb-4">Book a Free Intro Call</h2>
          <p class="text-slate-600 mb-6">
            30 minutes. We'll talk through where you are with AI and what would help.
          </p>
          <a
            href="https://app.reclaim.ai/m/diana-pfeil/meet-with-diana"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-sunbeam-400 hover:bg-sunbeam-500 text-slate-900 font-semibold px-6 py-3 rounded-lg transition-colors shadow-sm"
          >
            Find a Time
          </a>
        </div>

        <!-- Contact form -->
        <div>
          <h2 class="text-xl font-bold text-slate-900 mb-4">Send a Message</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
