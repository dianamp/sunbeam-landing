---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CredentialStrip from '../components/CredentialStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';
import Testimonials from '../components/Testimonials.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Sunbeam Consulting | AI Strategy and Execution for Startups">
  <Hero />
  <CredentialStrip />

  <!-- Who I Help -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 text-center mb-4">Who I Work With</h2>
      <p class="text-lg text-slate-600 text-center max-w-2xl mx-auto mb-12">
        Startups where AI is becoming central
        to product direction or fundraising.
      </p>

      <div class="grid md:grid-cols-2 gap-6 text-center max-w-3xl mx-auto">
        <div class="p-6">
          <div class="text-3xl mb-3">🚀</div>
          <h3 class="font-semibold text-slate-900 mb-2">Seed to Scale-up</h3>
          <p class="text-slate-600 text-sm">Startups from early-stage through scaled, where AI strategy and execution shape the next chapter.</p>
        </div>
        <div class="p-6">
          <div class="text-3xl mb-3">✨</div>
          <h3 class="font-semibold text-slate-900 mb-2">Founders & CTOs</h3>
          <p class="text-slate-600 text-sm">Leaders who need a strategic partner to sharpen the roadmap, unblock the team, and execute on AI with real outcomes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services preview -->
  <section class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 text-center mb-4">How I Help</h2>
      <p class="text-lg text-slate-600 text-center max-w-2xl mx-auto mb-12">
        Three focused offerings designed to give you clarity, momentum, and results.
      </p>
      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <ServiceCard
          title="Fractional Head of AI"
          description="AI leadership without the full-time hire. Strategic sounding board, roadmap and feasibility checks, staffing guidance, and investor support, embedded with your team."
        />
        <ServiceCard
          title="AI Strategy Sprint"
          description="5 weeks to a clear AI strategy. Stakeholder discovery, competitive review, and a strategy document your board, team, and customers can rally behind."
        />
        <ServiceCard
          title="Executive Coaching"
          description="Management, team scaling, hiring, delegation, and getting stakeholder buy-in for AI/ML work. For technical leaders growing into the role."
        />
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- From the blog -->
  {latestPosts.length > 0 && (
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 text-center mb-4">From the Blog</h2>
        <p class="text-lg text-slate-600 text-center max-w-2xl mx-auto mb-12">
          Practical thinking on building AI products that work.
        </p>
        <div class="grid md:grid-cols-3 gap-8">
          {latestPosts.map((post) => (
            <BlogPostCard
              title={post.data.title}
              date={post.data.date}
              description={post.data.description}
              slug={post.id}
            />
          ))}
        </div>
        <div class="text-center mt-10">
          <a href="/blog" class="text-sunbeam-600 hover:text-sunbeam-700 font-semibold">
            View all posts &rarr;
          </a>
        </div>
      </div>
    </section>
  )}

  <CTASection />
</BaseLayout>
