---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Sunbeam Consulting" description="Practical thinking on AI strategy, ML product development, and building AI features that work.">
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">Blog</h1>
      <p class="text-lg text-slate-600 mb-12 max-w-2xl">
        Practical thinking on AI strategy, ML product development, and building AI features that actually work.
      </p>

      {sortedPosts.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <BlogPostCard
              title={post.data.title}
              date={post.data.date}
              description={post.data.description}
              slug={post.id}
            />
          ))}
        </div>
      ) : (
        <p class="text-slate-500">Posts coming soon.</p>
      )}
    </div>
  </section>
</BaseLayout>
