---
interface Props {
  heading?: string;
  body?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  heading = 'Ready to get unstuck and ship something real?',
  body = "Let's talk — no pitch, just a conversation about where you are and how I can help.",
  buttonText = 'Book a Free Intro Call',
  buttonHref = '/contact',
} = Astro.props;
---

<section class="bg-gradient-to-r from-sunbeam-400 to-sunbeam-500 py-16 md:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">{heading}</h2>
    <p class="text-lg text-slate-800 mb-8">{body}</p>
    <a
      href={buttonHref}
      class="inline-block bg-slate-900 hover:bg-slate-800 text-white font-semibold px-8 py-3.5 rounded-lg text-lg transition-colors"
    >
      {buttonText}
    </a>
  </div>
</section>
