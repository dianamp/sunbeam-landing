---
const credentials = [
  { emoji: '🤗', label: '20 Years in ML and AI' },
  { emoji: '📦', label: 'Ex-Amazon' },
  { emoji: '🚀', label: '2x AI Startup CTO' },
  { emoji: '🎓', label: 'MIT PhD' },
];
---

<section class="py-14 bg-white border-y border-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap justify-center gap-6 md:gap-10">
      {credentials.map((cred) => (
        <div class="flex items-center gap-2.5 text-slate-700">
          <span class="text-xl md:text-2xl" aria-hidden="true">{cred.emoji}</span>
          <span class="text-base md:text-lg font-semibold">{cred.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
