---
interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
}

const { title, date, description, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="bg-white border border-slate-200 rounded-xl p-6 hover:shadow-lg transition-shadow">
  <time class="text-xs text-slate-500 font-medium uppercase tracking-wide">{formattedDate}</time>
  <h3 class="text-lg font-bold text-slate-900 mt-2 mb-2">
    <a href={`/blog/${slug}`} class="hover:text-sunbeam-600 transition-colors">{title}</a>
  </h3>
  <p class="text-slate-600 text-sm leading-relaxed line-clamp-3">{description}</p>
  <a
    href={`/blog/${slug}`}
    class="inline-block mt-4 text-sm font-semibold text-sunbeam-600 hover:text-sunbeam-700 transition-colors"
  >
    Read more &rarr;
  </a>
</article>
