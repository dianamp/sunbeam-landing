---
const testimonials = [
  {
    quote: "Diana helped us go from 'we should probably do something with AI' to a clear roadmap and our first ML feature in production. She cut through the hype and focused us on what would actually move the needle.",
    name: "Placeholder 1",
    title: "CEO, Company Name",
  },
  {
    quote: "I trust Diana as an advisor on the most difficult technical problems I encounter. She's a rare triple threat in terms of: the fundamentals and mental horsepower of a researcher, the pragmatic craft of a consummate engineer, and expert communication with a high content-to-word ratio.",
    name: "Gautam",
    title: "Co-Founder and CTO",
  },
  {
    quote: "Diana's empathetic approach to coaching made Diana a partner who helped me to be a confident leader by understanding and resolving technical, people and self-made blockers. Her understanding of management and technical skills helped us to navigate all types of challenges together.",
    name: "Balazs",
    title: "Head of Engineering @ Superlinked",
  },
  {
    quote: "Diana's biggest impact was introducing me to two mental models: One that I use daily to make high-stakes decisions, and the second that has helped me run a tighter execution cycle with my team. She stands out in her ability to introduce frameworks that dovetail with the context presented to her rather than merely cargo-cult or anchor to her past experience.",
    name: "Kao",
    title: "CTO, Coverbase",
  },
];
---

<section class="py-16 md:py-24 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-900 text-center mb-4">What Clients Say</h2>
    <p class="text-lg text-slate-600 text-center max-w-2xl mx-auto mb-12">
      Founders and technical leaders I've worked with.
    </p>
    <div class="grid md:grid-cols-2 gap-8">
      {testimonials.map((t) => (
        <div class="bg-white rounded-xl p-8 shadow-sm border border-slate-100">
          <blockquote class="text-slate-700 leading-relaxed mb-6">
            &ldquo;{t.quote}&rdquo;
          </blockquote>
          <div>
            <p class="font-semibold text-slate-900">{t.name}</p>
            <p class="text-sm text-slate-500">{t.title}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
