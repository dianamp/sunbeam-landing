---
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="text-center md:text-left">
        <p class="text-white font-semibold text-lg">
          <span class="text-sunbeam-400">Sunbeam</span> Consulting
        </p>
        <p class="text-sm mt-1">AI strategy and fractional leadership for startups</p>
      </div>

      <div class="flex items-center gap-6 text-sm">
        <a href="/contact" class="hover:text-white transition-colors">Book a Call</a>
        <a
          href="https://www.linkedin.com/in/dianampfeil/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-8 pt-6 text-center text-xs">
      <p>&copy; {year} Sunbeam Consulting. All rights reserved.</p>
    </div>
  </div>
</footer>
